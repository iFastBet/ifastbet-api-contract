{
  "name": "ifastbet adminka API contract",
  "version": "0.1.0",
  "routes": [
    { "operation": "structure.read", "method": "POST", "path": "/api/structure/read" },
    { "operation": "dashboard.read", "method": "POST", "path": "/api/dashboard" },
    { "operation": "dealers.create", "method": "POST", "path": "/api/dealers" },
    { "operation": "dealers.update", "method": "PATCH", "path": "/api/dealers/{id}" },
    { "operation": "agents.create", "method": "POST", "path": "/api/agents" },
    { "operation": "agents.update", "method": "PATCH", "path": "/api/agents/{id}" },
    { "operation": "halls.create", "method": "POST", "path": "/api/halls" },
    { "operation": "halls.panic", "method": "POST", "path": "/api/halls/{id}/panic" },
    { "operation": "halls.unpanic", "method": "POST", "path": "/api/halls/{id}/unpanic" },
    { "operation": "halls.regenerateTvToken", "method": "POST", "path": "/api/halls/{id}/regenerate-tv-token" },
    { "operation": "halls.update", "method": "PATCH", "path": "/api/halls/{id}" },
    { "operation": "users.create", "method": "POST", "path": "/api/users" },
    { "operation": "users.update", "method": "PATCH", "path": "/api/users/{id}" },
    { "operation": "users.remove", "method": "DELETE", "path": "/api/users/{id}" },
    { "operation": "currencies.summary", "method": "GET", "path": "/api/currencies/summary" },
    { "operation": "currencies.create", "method": "POST", "path": "/api/currencies" },
    { "operation": "currencies.update", "method": "PATCH", "path": "/api/currencies/{id}" },
    { "operation": "nodeCurrencies.grant", "method": "POST", "path": "/api/node-currencies" },
    { "operation": "nodeCurrencies.revoke", "method": "DELETE", "path": "/api/node-currencies/{id}" },
    { "operation": "nodeGameLimits.create", "method": "POST", "path": "/api/node-game-limits" },
    { "operation": "nodeGameLimits.update", "method": "PATCH", "path": "/api/node-game-limits/{id}" },
    { "operation": "nodeGameLimits.remove", "method": "DELETE", "path": "/api/node-game-limits/{id}" },
    { "operation": "transactions.emit", "method": "POST", "path": "/api/emit" },
    { "operation": "transactions.transfer", "method": "POST", "path": "/api/transfer" },
    { "operation": "transactions.grantAndTransfer", "method": "POST", "path": "/api/grant-and-transfer" },
    { "operation": "creditPricing.setDefault", "method": "POST", "path": "/api/credit-pricing/default" },
    { "operation": "creditPricing.setOverride", "method": "POST", "path": "/api/credit-pricing/override" },
    { "operation": "settlements.summary", "method": "POST", "path": "/api/settlements/summary" },
    { "operation": "settlements.entries", "method": "POST", "path": "/api/settlements/entries" },
    { "operation": "settlements.quote", "method": "POST", "path": "/api/exchange-rates/quote" },
    { "operation": "settlements.payment", "method": "POST", "path": "/api/settlements/payment" },
    { "operation": "settlements.adjust", "method": "POST", "path": "/api/settlements/adjust" },
    { "operation": "settlements.reverse", "method": "POST", "path": "/api/settlements/reverse" },
    { "operation": "rollups.read", "method": "POST", "path": "/api/rollups/read" },
    { "operation": "journal.read", "method": "POST", "path": "/api/journal/read" },
    { "operation": "profile.update", "method": "PATCH", "path": "/api/profile" },
    { "operation": "games.update", "method": "PATCH", "path": "/api/games/{id}" },
    { "operation": "tickets.lookup", "method": "POST", "path": "/api/tickets/lookup" },
    { "operation": "tickets.preview", "method": "POST", "path": "/api/tickets/payout/preview" },
    { "operation": "tickets.intake", "method": "POST", "path": "/api/tickets" },
    { "operation": "tickets.summary", "method": "POST", "path": "/api/tickets/summary" },
    { "operation": "tickets.payout", "method": "POST", "path": "/api/tickets/payout" }
  ],
  "pocketbase": {
    "collections": {
      "users": { "auth": true, "realtime": true },
      "permissions": {},
      "nodes": { "realtime": true },
      "currencies": { "realtime": true },
      "node_currencies": { "realtime": true },
      "node_game_limits": { "realtime": true },
      "games": { "queryFields": ["code"] },
      "balances": { "realtime": true },
      "transactions": { "realtime": true, "queryFields": ["created_at"] },
      "rounds": { "realtime": true, "queryFields": ["started_at"] },
      "broadcasts": { "realtime": true },
      "tickets": { "realtime": true, "queryFields": ["created_at", "game", "round", "currency"] }
    }
  }
}
